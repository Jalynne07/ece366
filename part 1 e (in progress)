module four_bit_RCA_RCS(A, B, Cin, S,
                        Cout); //i will connect by name, the structural name of my one bit adder is: one_bit_full_adder

  reg [3:0] A, B; //for test benches the inputs need to be reg
reg Cin;
  wire [3:0] S; //testbenches the outputs need to be wires
wire Cout;
  
  wire cout1;
  wire cout2;
  wire cout3;
  
  wire rca_subtract; //= 1;
  or(rca_subtract, Cin, 1); //this line is for the rcs for rca test bench this is not needed
  //always gives output of 1 which we need as cin for subtractor
  
  wire binvert0;
  not(binvert0, B[0]); //inverting the b input and storing it
  
  wire binvert1;
  not(binvert1, B[1]);
  
  wire binvert2;
  not(binvert2, B[2]);
  
  wire binvert3;
  not(binvert3, B[3]);

  one_bit_full_adder block1(
    .a           (A[0]), //to connect the variables this is the syntax used
    .b           (B[0]),
//    .b           (binvert0), //this line is for subtraction
    //    .cin          (rca_subtract), //this line is for the rcs for rca test ebnch i will comment it out
    .cin		 (Cin),
    
    //this cin for the first input is Cin, for the rest it is the carryout of the before adder as characteristic of full adders
    .s         (S[0]),
    .cout          (cout1)
  
  );
  
  one_bit_full_adder block2(
    .a           (A[1]),
    .b           (B[1]),
 //   .b           (binvert1), //this line is for subtraction
    .cin          (cout1), //this cin for the first input is cout1 the cout output of block1
    .s         (S[1]),
    .cout          (cout2)
  
  );
  
  one_bit_full_adder block3(
    .a           (A[2]),
    .b           (B[2]),
    //   .b           (binvert2), //this line is for subtraction
    .cin          (cout2), //this cin for the first input is cout2 the cout output of block2
    .s         (S[2]),
    .cout          (cout3)
  
  );
  
  one_bit_full_adder block4(
    .a           (A[3]),
    .b           (B[3]),
    //    .b           (binvert3), //this line is for subtraction
    .cin          (cout3), //this cin for the first input is cout3 the cout output of block3
    .s         (S[3]),
    .cout          (Cout)
  
  );
  
  initial
    begin //set the variables here - //unsigned addition
      A[0] = 1;
      B[0] = 1;
      Cin = 0;
    end
  always
    #5 $display ("this is the added value %b %b %b %b, this is the carryout: %b", S[0], S[1], S[2], S[3], Cout);;

 endmodule
